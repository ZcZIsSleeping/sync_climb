{
  "name": "syn-climb-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "test": "WECHAT_APPID= WECHAT_SECRET= DATABASE_URL=postgres://syn_climb:syn_climb@localhost:5432/syn_climb_test vitest run",
    "test:unit": "WECHAT_APPID= WECHAT_SECRET= DATABASE_URL=postgres://syn_climb:syn_climb@localhost:5432/syn_climb_test vitest run tests/unit",
    "test:integration": "WECHAT_APPID= WECHAT_SECRET= DATABASE_URL=postgres://syn_climb:syn_climb@localhost:5432/syn_climb_test vitest run tests/integration"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "nanoid": "^5.1.6",
    "pg": "^8.21.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  }
}
