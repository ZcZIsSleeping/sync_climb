page {
  min-height: 100vh;
  background: #f5f7fb;
  color: #172335;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 18rpx;
}

.app-shell {
  height: calc(100vh - 36rpx);
  overflow: hidden;
  border: 1rpx solid rgba(126, 143, 164, 0.25);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 24rpx 70rpx rgba(39, 58, 82, 0.12);
}

.topbar {
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 40rpx;
  border-bottom: 1rpx solid rgba(143, 156, 174, 0.22);
}

.brand {
  font-size: 34rpx;
  font-weight: 700;
}

.topbar-actions {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.icon-button {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-icon {
  width: 28rpx;
  height: 34rpx;
  border: 4rpx solid #172335;
  border-bottom: 0;
  clip-path: polygon(0 0, 100% 0, 62% 45%, 62% 100%, 43% 100%, 43% 45%);
}

.plus-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  border: 4rpx solid #172335;
  border-radius: 50%;
}

.plus-icon::before,
.plus-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #172335;
  transform: translate(-50%, -50%);
}

.plus-icon::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.calendar-scroll {
  height: calc(100vh - 284rpx);
}

.month {
  padding: 24rpx 24rpx 8rpx;
}

.month-title {
  margin: 0 0 22rpx 16rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.weekday-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding-bottom: 12rpx;
}

.weekday {
  text-align: center;
  color: #7b8493;
  font-size: 19rpx;
}

.month-grid {
  border-top: 1rpx solid rgba(159, 171, 187, 0.25);
  border-left: 1rpx solid rgba(159, 171, 187, 0.25);
}

.week-row {
  position: relative;
  height: 154rpx;
}

.days-layer {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.day-cell {
  position: relative;
  min-width: 0;
  box-sizing: border-box;
  border-right: 1rpx solid rgba(159, 171, 187, 0.25);
  border-bottom: 1rpx solid rgba(159, 171, 187, 0.25);
  background: rgba(255, 255, 255, 0.3);
}

.day-cell--blank {
  background: rgba(250, 252, 255, 0.52);
}

.day-cell--selecting {
  background: rgba(142, 184, 229, 0.16);
  box-shadow: inset 0 0 0 2rpx rgba(91, 145, 204, 0.25);
}

.day-cell--expanded {
  z-index: 2;
  background: rgba(224, 237, 252, 0.68);
  box-shadow: inset 0 0 0 2rpx rgba(82, 143, 211, 0.38), 0 8rpx 22rpx rgba(68, 116, 170, 0.14);
}

.day-number {
  position: absolute;
  top: 16rpx;
  left: 18rpx;
  color: #253246;
  font-size: 20rpx;
  line-height: 28rpx;
}

.day-number--today {
  min-width: 30rpx;
  height: 30rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #4b8fda;
}

.event-layer {
  pointer-events: none;
  position: absolute;
  inset: 0;
}

.event-segment {
  position: absolute;
  height: 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  border: 1rpx solid rgba(84, 144, 207, 0.18);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
}

.event-segment--blue {
  background: linear-gradient(90deg, rgba(199, 225, 251, 0.95), rgba(213, 233, 253, 0.78));
}

.event-segment--pink {
  background: linear-gradient(90deg, rgba(246, 210, 220, 0.95), rgba(250, 225, 232, 0.78));
  border-color: rgba(210, 129, 151, 0.16);
}

.segment-title {
  overflow: hidden;
  color: #2363a5;
  font-size: 17rpx;
  font-weight: 650;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.event-segment--pink .segment-title {
  color: #9c5165;
}

.more-marker {
  position: absolute;
  height: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(232, 239, 248, 0.82);
  color: #607085;
  font-size: 17rpx;
  font-weight: 700;
}

.scroll-spacer {
  height: 20rpx;
}

.tabbar {
  height: 144rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: center;
  border-top: 1rpx solid rgba(143, 156, 174, 0.22);
  background: rgba(255, 255, 255, 0.84);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #7f8794;
  font-size: 19rpx;
}

.tab-item--active {
  color: #1d74df;
}

.calendar-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
}

.calendar-icon::before,
.calendar-icon::after {
  content: "";
  position: absolute;
  top: -8rpx;
  width: 4rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.calendar-icon::before {
  left: 7rpx;
}

.calendar-icon::after {
  right: 7rpx;
}

.team-icon {
  position: relative;
  width: 46rpx;
  height: 38rpx;
}

.team-head {
  position: absolute;
  top: 0;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.team-head--left {
  left: 6rpx;
}

.team-head--right {
  right: 6rpx;
}

.team-body {
  position: absolute;
  bottom: 0;
  width: 24rpx;
  height: 16rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 16rpx 16rpx 0 0;
}

.team-body--left {
  left: 0;
}

.team-body--right {
  right: 0;
}

.tent-icon {
  position: relative;
  width: 48rpx;
  height: 38rpx;
}

.tent-icon::before,
.tent-icon::after {
  content: "";
  position: absolute;
  bottom: 0;
  width: 28rpx;
  height: 34rpx;
  border: 3rpx solid currentColor;
  border-bottom-width: 4rpx;
  transform: skewX(-22deg);
}

.tent-icon::before {
  left: 6rpx;
}

.tent-icon::after {
  right: 6rpx;
  transform: skewX(22deg);
}

.expanded-backdrop,
.edit-backdrop {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(214, 222, 233, 0.46);
  backdrop-filter: blur(16rpx);
  animation: backdrop-fade-in 180ms ease-out both;
}

.expanded-panel {
  position: fixed;
  left: 34rpx;
  right: 34rpx;
  max-height: 62vh;
  overflow: auto;
  box-sizing: border-box;
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 30rpx 86rpx rgba(38, 54, 78, 0.2);
  backdrop-filter: blur(26rpx);
  animation: panel-pop-in 320ms cubic-bezier(0.18, 0.88, 0.28, 1.12) both;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.panel-title {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  font-size: 27rpx;
  font-weight: 650;
}

.panel-subtitle,
.preview-id,
.preview-time,
.edit-meta {
  color: #788394;
  font-size: 17rpx;
}

.close-button {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6c7583;
  border: 1rpx solid rgba(123, 137, 155, 0.22);
  border-radius: 50%;
  background: rgba(232, 237, 244, 0.84);
  font-size: 30rpx;
  line-height: 42rpx;
}

.event-preview {
  min-height: 70rpx;
  display: grid;
  grid-template-columns: 8rpx 1fr auto;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  margin-top: 8rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.74);
  box-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.8), 0 10rpx 28rpx rgba(55, 73, 99, 0.07);
  animation: preview-slide-in 260ms ease-out both;
}

.preview-accent {
  width: 6rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: #4b8fda;
}

.preview-accent--pink {
  background: #d98ea2;
}

.preview-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.preview-title {
  overflow: hidden;
  color: #172335;
  font-size: 20rpx;
  font-weight: 650;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.preview-time {
  white-space: nowrap;
}

.create-sheet {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 28rpx;
  z-index: 30;
  animation: sheet-in 260ms ease-out both;
}

.sheet-card,
.edit-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(127, 143, 164, 0.24);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 52rpx rgba(38, 54, 78, 0.16);
  backdrop-filter: blur(20rpx);
}

.sheet-card {
  padding: 20rpx;
  display: grid;
  grid-template-columns: 176rpx 1fr auto;
  align-items: center;
  gap: 16rpx;
}

.sheet-title,
.sheet-range {
  display: block;
}

.sheet-title {
  font-size: 20rpx;
  font-weight: 650;
}

.sheet-range {
  margin-top: 4rpx;
  color: #748092;
  font-size: 17rpx;
}

.sheet-input,
.edit-input {
  min-width: 0;
  height: 58rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: rgba(240, 244, 249, 0.86);
  color: #172335;
  font-size: 20rpx;
}

.sheet-actions,
.edit-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.primary-button,
.ghost-button,
.delete-button {
  height: 56rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  line-height: 56rpx;
}

.primary-button {
  background: #3f83d4;
  color: #ffffff;
}

.ghost-button {
  background: #eef3f8;
  color: #607085;
}

.delete-button {
  background: #f5e4e8;
  color: #9b5264;
}

.primary-button::after,
.ghost-button::after,
.delete-button::after {
  border: 0;
}

.edit-backdrop {
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 34rpx;
}

.edit-card {
  width: 100%;
  padding: 28rpx;
  animation: panel-pop-in 260ms ease-out both;
}

.edit-heading {
  display: block;
  margin-bottom: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.edit-meta {
  margin-top: 12rpx;
}

.edit-actions {
  justify-content: space-between;
  margin-top: 24rpx;
}

@keyframes backdrop-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes panel-pop-in {
  0% {
    opacity: 0;
    transform: translateY(20rpx) scale(0.94);
  }
  70% {
    opacity: 1;
    transform: translateY(-3rpx) scale(1.01);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes preview-slide-in {
  from {
    opacity: 0;
    transform: translateY(14rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes sheet-in {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
