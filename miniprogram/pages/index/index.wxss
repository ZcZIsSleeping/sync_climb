@keyframes backdrop-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes backdrop-fade-out {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

@keyframes panel-pop-in {
  0% {
    opacity: 0;
    transform: translateY(20rpx) scale(0.94);
  }
  70% {
    opacity: 1;
    transform: translateY(-3rpx) scale(1.01);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes gear-panel-down {
  from {
    opacity: 0;
    transform: translateY(-430rpx);
