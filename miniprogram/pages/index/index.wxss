page {
  min-height: 100vh;
  background: #f5f7fb;
  color: #172335;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 18rpx;
}

.app-shell {
  position: relative;
  display: flex;
  flex-direction: column;
  height: calc(100vh - 36rpx);
  overflow: hidden;
  border: 1rpx solid rgba(126, 143, 164, 0.25);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 24rpx 70rpx rgba(39, 58, 82, 0.12);
}

.topbar {
  flex: 0 0 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 40rpx;
  border-bottom: 1rpx solid rgba(143, 156, 174, 0.22);
}

.brand {
  font-size: 34rpx;
  font-weight: 700;
}

.calendar-scroll {
  flex: 1 1 auto;
  min-height: 0;
  height: auto;
}

.basecamp-scroll,
.team-scroll,
.team-detail,
.placeholder-view {
  flex: 1 1 auto;
  min-height: 0;
  height: auto;
}

.month {
  padding: 24rpx 24rpx 8rpx;
}

.month-title {
  margin: 0 0 22rpx 16rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.weekday-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding-bottom: 12rpx;
}

.weekday {
  text-align: center;
  color: #7b8493;
  font-size: 19rpx;
}

.month-grid {
  border-top: 1rpx solid rgba(159, 171, 187, 0.25);
  border-left: 1rpx solid rgba(159, 171, 187, 0.25);
}

.week-row {
  position: relative;
  height: 184rpx;
}

.days-layer {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.day-cell {
  position: relative;
  min-width: 0;
  box-sizing: border-box;
  border-right: 1rpx solid rgba(159, 171, 187, 0.25);
  border-bottom: 1rpx solid rgba(159, 171, 187, 0.25);
  background: rgba(255, 255, 255, 0.3);
}

.day-cell--blank {
  background: rgba(250, 252, 255, 0.52);
}

.day-cell--selecting {
  background: rgba(142, 184, 229, 0.16);
  box-shadow: inset 0 0 0 2rpx rgba(91, 145, 204, 0.25);
}

.day-cell--expanded {
  z-index: 2;
  background: rgba(224, 237, 252, 0.68);
  box-shadow: inset 0 0 0 2rpx rgba(82, 143, 211, 0.38), 0 8rpx 22rpx rgba(68, 116, 170, 0.14);
}

.day-number {
  position: absolute;
  top: 16rpx;
  left: 18rpx;
  color: #253246;
  font-size: 20rpx;
  line-height: 28rpx;
}

.day-number--today {
  min-width: 30rpx;
  height: 30rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #d94d4d;
}

.today-float-button {
  position: absolute;
  right: 34rpx;
  bottom: 132rpx;
  z-index: 12;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.64);
  color: #d94d4d;
  font-size: 30rpx;
  font-weight: 900;
  backdrop-filter: blur(18rpx);
  box-shadow: 0 18rpx 40rpx rgba(55, 73, 99, 0.18), inset 0 0 0 1rpx rgba(255, 255, 255, 0.7);
}

.event-layer {
  pointer-events: none;
  position: absolute;
  inset: 0;
}

.calendar-event-layer .event-segment,
.calendar-more-marker {
  pointer-events: auto;
}

.event-segment {
  position: absolute;
  height: 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  border: 1rpx solid rgba(84, 144, 207, 0.18);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
}

.drag-ghost {
  position: fixed;
  z-index: 60;
  width: 184rpx;
  height: 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  border: 1rpx solid rgba(84, 144, 207, 0.18);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 40rpx rgba(55, 73, 99, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
  opacity: 0.94;
  pointer-events: none;
  transform: scale(0.88);
  transform-origin: center;
  animation: drag-ghost-pick 160ms ease-out both;
}

.drag-ghost .segment-title {
  font-size: 16rpx;
}

.drop-preview,
.selection-preview {
  position: fixed;
  z-index: 59;
  min-width: 76rpx;
  min-height: 44rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 8rpx 8rpx;
  border: 3rpx solid rgba(217, 77, 77, 0.56);
  border-radius: 18rpx;
  background: rgba(217, 77, 77, 0.08);
  color: #9b3d3d;
  font-size: 16rpx;
  font-weight: 850;
  pointer-events: none;
  backdrop-filter: blur(8rpx);
  box-shadow: 0 12rpx 30rpx rgba(55, 73, 99, 0.14);
}

.selection-preview {
  z-index: 58;
  border-color: rgba(75, 143, 218, 0.55);
  background: rgba(75, 143, 218, 0.08);
  color: #2363a5;
}

.event-segment--blue {
  background: linear-gradient(90deg, rgba(199, 225, 251, 0.95), rgba(213, 233, 253, 0.78));
}

.event-segment--pink {
  background: linear-gradient(90deg, rgba(246, 210, 220, 0.95), rgba(250, 225, 232, 0.78));
  border-color: rgba(210, 129, 151, 0.16);
}

.event-segment--green {
  background: linear-gradient(90deg, rgba(203, 231, 215, 0.95), rgba(221, 240, 229, 0.78));
  border-color: rgba(110, 169, 135, 0.16);
}

.event-segment--violet {
  background: linear-gradient(90deg, rgba(221, 214, 246, 0.95), rgba(232, 227, 250, 0.78));
  border-color: rgba(145, 124, 207, 0.16);
}

.event-segment--pending {
  border-style: dashed;
  border-width: 3rpx;
  background: rgba(255, 255, 255, 0.44);
  box-shadow: none;
}

.segment-title {
  overflow: hidden;
  color: #2363a5;
  font-size: 17rpx;
  font-weight: 650;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.event-segment--pink .segment-title {
  color: #9c5165;
}

.event-segment--green .segment-title {
  color: #437557;
}

.event-segment--violet .segment-title {
  color: #665aa5;
}

.team-event-layer {
  pointer-events: none;
}

.team-event-layer .event-segment {
  pointer-events: auto;
}

.team-more-marker {
  pointer-events: auto;
}

.more-marker {
  position: absolute;
  height: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(232, 239, 248, 0.82);
  color: #607085;
  font-size: 17rpx;
  font-weight: 700;
}

.scroll-spacer {
  height: 20rpx;
}

.placeholder-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #7f8794;
}

.placeholder-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  border-radius: 32rpx;
  background: rgba(243, 247, 251, 0.86);
  box-shadow: inset 0 0 0 1rpx rgba(127, 143, 164, 0.16);
}

.placeholder-title {
  color: #253246;
  font-size: 28rpx;
  font-weight: 700;
}

.placeholder-text {
  margin-top: 8rpx;
  font-size: 19rpx;
}

.team-list {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-sizing: border-box;
  padding: 28rpx 26rpx 40rpx;
}

.team-empty {
  flex: 1;
  min-height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a1a9b5;
  font-size: 28rpx;
  font-weight: 650;
}

.team-card {
  min-height: 112rpx;
  display: grid;
  grid-template-columns: 76rpx 1fr auto;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border: 1rpx solid rgba(127, 143, 164, 0.18);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 14rpx 36rpx rgba(39, 58, 82, 0.08);
}

.team-edit-tab {
  position: absolute;
  right: 0;
  top: 64%;
  z-index: 11;
  width: 68rpx;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx 0 0 24rpx;
  background: rgba(213, 233, 253, 0.94);
  color: #2363a5;
  font-size: 17rpx;
  font-weight: 800;
  box-shadow: 0 14rpx 30rpx rgba(55, 73, 99, 0.1);
}

.team-card--pinned {
  background: rgba(238, 241, 245, 0.86);
  border-color: rgba(113, 128, 148, 0.2);
}

.team-avatar,
.member-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 50%;
  color: #285d95;
  font-weight: 800;
  background: linear-gradient(135deg, rgba(199, 225, 251, 0.95), rgba(246, 210, 220, 0.78));
}

.team-avatar {
  width: 76rpx;
  height: 76rpx;
  font-size: 30rpx;
}

.team-card-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.team-card-title {
  overflow: hidden;
  color: #172335;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.team-card-count {
  color: #7f8794;
  font-size: 17rpx;
}

.team-card-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.team-pin-button,
.team-exit-button,
.team-back-button,
.team-gear-toggle,
.team-filter,
.room-copy {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-weight: 700;
}

.team-pin-button,
.team-exit-button {
  width: 52rpx;
  height: 52rpx;
  font-size: 24rpx;
}

.team-pin-button {
  width: 52rpx;
  background: rgba(221, 240, 229, 0.9);
  color: #437557;
  font-size: 26rpx;
}

.team-pin-button--active {
  width: 52rpx;
  background: rgba(229, 233, 238, 0.94);
  color: #536174;
  box-shadow: inset 0 0 0 2rpx rgba(67, 117, 87, 0.22);
}

.team-exit-button {
  background: rgba(245, 228, 232, 0.92);
  color: #9b5264;
  font-size: 30rpx;
}

.team-detail {
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.team-detail-head {
  position: relative;
  box-sizing: border-box;
  padding: 22rpx 26rpx 26rpx;
  border-bottom: 1rpx solid rgba(143, 156, 174, 0.18);
}

.team-title-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: center;
  gap: 12rpx;
}

.team-name-input {
  min-width: 0;
  height: 62rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  border-radius: 20rpx;
  background: rgba(246, 249, 252, 0.74);
  color: #172335;
  font-size: 28rpx;
  font-weight: 800;
}

.room-copy {
  height: 46rpx;
  gap: 6rpx;
  padding: 0 14rpx;
  background: rgba(238, 243, 248, 0.88);
  color: #667386;
  font-size: 17rpx;
}

.room-copy-icon {
  color: #2877d2;
  font-size: 18rpx;
}

.team-filter {
  height: 46rpx;
  padding: 0 16rpx;
  background: rgba(238, 243, 248, 0.88);
  color: #667386;
  font-size: 17rpx;
  white-space: nowrap;
}

.team-filter--active {
  background: rgba(213, 233, 253, 0.88);
  color: #2363a5;
}

.team-sub-actions {
  display: flex;
  justify-content: flex-start;
  margin-top: 14rpx;
}

.team-back-button,
.team-gear-toggle {
  height: 48rpx;
  padding: 0 18rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #607085;
  font-size: 18rpx;
}

.team-gear-toggle {
  color: #2363a5;
}

.gear-pull-tab {
  position: absolute;
  left: 50%;
  bottom: -22rpx;
  z-index: 9;
  width: 108rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 20rpx 20rpx;
  background: rgba(213, 233, 253, 0.94);
  color: #2363a5;
  font-size: 17rpx;
  font-weight: 800;
  transform: translateX(-50%);
  box-shadow: 0 10rpx 24rpx rgba(55, 73, 99, 0.08);
}

.gear-pull-tab::after {
  content: "";
  position: absolute;
  top: 7rpx;
  width: 34rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(35, 99, 165, 0.38);
}

.gear-pull-tab text {
  margin-top: 10rpx;
}

.team-gear-panel-shell {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 8;
  box-sizing: border-box;
  height: 430rpx;
  padding: 18rpx 26rpx 0;
  opacity: 0;
  pointer-events: none;
  transform: translateY(-430rpx);
}

.team-gear-panel-shell--open {
  opacity: 1;
  pointer-events: auto;
  animation: gear-panel-down 240ms ease-out both;
}

.team-gear-panel-shell--closing {
  pointer-events: none;
  animation: gear-panel-up 220ms ease-in both;
}

.team-gear-panel {
  position: relative;
  box-sizing: border-box;
  height: 392rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(127, 143, 164, 0.18);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.86);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 14rpx 36rpx rgba(39, 58, 82, 0.08);
}

.gear-pull-tab--panel-bottom {
  bottom: -22rpx;
}

.team-gear-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.member-search {
  height: 58rpx;
  margin-top: 14rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: rgba(246, 249, 252, 0.9);
  color: #172335;
  font-size: 19rpx;
}

.member-gear-scroll {
  height: 284rpx;
  margin-top: 14rpx;
  white-space: nowrap;
}

.member-gear-track {
  display: inline-flex;
  gap: 14rpx;
  height: 284rpx;
}

.member-gear-column {
  width: 230rpx;
  height: 284rpx;
  display: inline-flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 14rpx;
  border-radius: 22rpx;
  background: rgba(246, 249, 252, 0.72);
}

.member-column-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.member-avatar {
  width: 48rpx;
  height: 48rpx;
  font-size: 20rpx;
  overflow: hidden;
}

.member-avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.member-avatar--green {
  background: rgba(203, 231, 215, 0.95);
  color: #437557;
}

.member-avatar--pink {
  background: rgba(246, 210, 220, 0.95);
  color: #9c5165;
}

.member-avatar--violet {
  background: rgba(221, 214, 246, 0.95);
  color: #665aa5;
}

.member-name {
  overflow: hidden;
  color: #172335;
  font-size: 20rpx;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.member-column-list {
  flex: 1;
  min-height: 0;
}

.member-gear-row,
.participant-gear-row {
  display: grid;
  grid-template-columns: 44rpx 1fr auto;
  align-items: center;
  gap: 10rpx;
  min-height: 54rpx;
  margin-bottom: 8rpx;
}

.member-gear-name,
.participant-gear-name {
  overflow: hidden;
  color: #536174;
  font-size: 18rpx;
  font-weight: 650;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.member-gear-count {
  color: #7f8794;
  font-size: 17rpx;
  font-weight: 700;
}

.team-calendar-scroll {
  flex: 1 1 auto;
  min-height: 0;
  height: auto;
}

.basecamp-content {
  min-height: 100%;
  box-sizing: border-box;
  padding: 28rpx 26rpx 40rpx;
}

.basecamp-content--logged-out {
  display: flex;
  align-items: center;
  justify-content: center;
}

.basecamp-content--logged-in {
  display: block;
}

.profile-panel,
.gear-section {
  box-sizing: border-box;
  border: 1rpx solid rgba(127, 143, 164, 0.2);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 16rpx 44rpx rgba(39, 58, 82, 0.08);
  backdrop-filter: blur(18rpx);
}

.profile-panel {
  min-height: 146rpx;
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.profile-panel--logged-out {
  width: 100%;
  min-height: 240rpx;
  justify-content: center;
  border-color: rgba(127, 143, 164, 0.14);
  background: rgba(255, 255, 255, 0.58);
}

.profile-panel--logged-in {
  animation: basecamp-profile-settle 260ms ease-out both;
}

.login-empty {
  width: 100%;
  display: flex;
  justify-content: center;
}

.login-button {
  height: 68rpx;
  margin: 0;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: #3f83d4;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 68rpx;
}

.login-button::after,
.gear-add-button::after {
  border: 0;
}

.profile-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar-button {
  width: 86rpx;
  min-width: 86rpx;
  max-width: 86rpx;
  height: 86rpx;
  min-height: 86rpx;
  max-height: 86rpx;
  margin: 0;
  padding: 0;
  flex: 0 0 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
}

.avatar-button::after {
  border: 0;
}

.avatar {
  width: 86rpx;
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(199, 225, 251, 0.95), rgba(246, 210, 220, 0.88));
  color: #285d95;
  font-size: 34rpx;
  font-weight: 800;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.72), 0 12rpx 28rpx rgba(55, 73, 99, 0.08);
}

.avatar-image {
  display: block;
  background: rgba(246, 249, 252, 0.86);
}

.nickname-display,
.nickname-input {
  min-width: 0;
  height: 72rpx;
  flex: 1;
  box-sizing: border-box;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: rgba(246, 249, 252, 0.82);
  color: #172335;
  font-size: 28rpx;
  font-weight: 800;
}

.nickname-display {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  line-height: 72rpx;
  text-align: left;
}

.nickname-input {
  display: block;
  line-height: 72rpx;
  text-align: left;
}

.logout-button {
  width: 112rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: rgba(245, 228, 232, 0.92);
  color: #9b5264;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 58rpx;
}

.logout-button::after {
  border: 0;
}

.gear-section {
  margin-top: 24rpx;
  padding: 24rpx;
  transform-origin: 50% 0;
  animation: gear-section-drop 360ms cubic-bezier(0.18, 0.88, 0.28, 1) both;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: #172335;
  font-size: 28rpx;
  font-weight: 800;
}

.section-count {
  color: #7f8794;
  font-size: 18rpx;
}

.gear-add-card {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  box-sizing: border-box;
  padding: 14rpx;
  border-radius: 24rpx;
  background: rgba(243, 247, 251, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(127, 143, 164, 0.12);
}

.gear-picker,
.gear-name-input,
.gear-add-button {
